# Optional KTX2 texture-pack decoder. No KTX or Basis source is copied into
# the profile. Bundled builds fetch an immutable, checksum-verified archive.
set(MHP2G_KTX2 "OFF" CACHE STRING "KTX2 texture packs: OFF, bundled, or system")
set_property(CACHE MHP2G_KTX2 PROPERTY STRINGS OFF bundled system)
string(TOLOWER "${MHP2G_KTX2}" _mhp2g_ktx_mode)
if(NOT _mhp2g_ktx_mode MATCHES "^(off|bundled|system)$")
    message(FATAL_ERROR "MHP2G_KTX2 must be OFF, bundled, or system")
endif()

if(_mhp2g_ktx_mode STREQUAL "bundled")
    if(CMAKE_VERSION VERSION_LESS "3.22")
        message(FATAL_ERROR "Bundled KTX2 requires CMake 3.22 or newer")
    endif()
    enable_language(C)
    function(_mhp2g_fetch_ktx)
        include(FetchContent)
        if(POLICY CMP0135)
            cmake_policy(SET CMP0135 NEW)
        endif()
        # Function scope keeps this library-type preference out of Poke and
        # other dependencies. The options below belong only to KTX.
        set(BUILD_SHARED_LIBS OFF)
        set(KTX_GIT_VERSION_FULL "v4.4.2")
        foreach(feature DOC JNI PY TESTS TOOLS TOOLS_CTS GL_UPLOAD VK_UPLOAD ETC_UNPACK)
            set(KTX_FEATURE_${feature} OFF CACHE BOOL "Disabled in Poke's KTX decoder dependency" FORCE)
        endforeach()
        set(KTX_FEATURE_KTX1 ON CACHE BOOL "Required by libktx generic reader linkage" FORCE)
        set(KTX_FEATURE_KTX2 ON CACHE BOOL "Read KTX2 packs" FORCE)
        set(KTX_FEATURE_LOADTEST_APPS OFF CACHE STRING "No KTX sample applications" FORCE)
        set(KTX_WERROR OFF CACHE BOOL "Do not promote dependency warnings" FORCE)
        set(BASISU_SUPPORT_OPENCL OFF CACHE BOOL "No encoding GPU dependency" FORCE)
        FetchContent_Declare(poke_ktx
            URL "https://codeload.github.com/KhronosGroup/KTX-Software/tar.gz/4d6fc70eaf62ad0558e63e8d97eb9766118327a6"
            URL_HASH SHA256=4d0a3c4470c67e0f1544d2a92f379dc919c9627a5c3fa5c4fcaf4c22324827f5)
        FetchContent_MakeAvailable(poke_ktx)
        set_target_properties(ktx PROPERTIES EXCLUDE_FROM_ALL TRUE)
        set_target_properties(ktx_read PROPERTIES POSITION_INDEPENDENT_CODE TRUE)
        # Keep upstream notices with build outputs for packaging. The fetched
        # source also retains all original notices and license files.
        set(notices "${CMAKE_BINARY_DIR}/bin/licenses/ktx-4.4.2")
        file(MAKE_DIRECTORY "${notices}")
        file(COPY "${poke_ktx_SOURCE_DIR}/LICENSE.md" "${poke_ktx_SOURCE_DIR}/LICENSES" DESTINATION "${notices}")
        foreach(part basisu basisu/zstd astc-encoder)
            foreach(name LICENSE LICENSE.txt LICENSE.md NOTICE)
                if(EXISTS "${poke_ktx_SOURCE_DIR}/external/${part}/${name}")
                    string(REPLACE "/" "-" label "${part}")
                    configure_file("${poke_ktx_SOURCE_DIR}/external/${part}/${name}"
                        "${notices}/${label}-${name}" COPYONLY)
                endif()
            endforeach()
        endforeach()
    endfunction()
    _mhp2g_fetch_ktx()
    set(_mhp2g_ktx_target ktx_read)
elseif(_mhp2g_ktx_mode STREQUAL "system")
    find_package(Ktx 4.4 CONFIG REQUIRED)
    if(TARGET KTX::ktx_read)
        set(_mhp2g_ktx_target KTX::ktx_read)
    elseif(TARGET KTX::ktx)
        set(_mhp2g_ktx_target KTX::ktx)
    else()
        message(FATAL_ERROR "Ktx package exports neither KTX::ktx_read nor KTX::ktx")
    endif()
endif()

function(mhp2g_use_ktx2 target)
    if(_mhp2g_ktx_target)
        target_compile_definitions(${target} PRIVATE MHP2G_HAS_KTX2=1)
        target_link_libraries(${target} PRIVATE ${_mhp2g_ktx_target})
    else()
        target_compile_definitions(${target} PRIVATE MHP2G_HAS_KTX2=0)
    endif()
endfunction()

message(STATUS "mhp2g: KTX2 texture-pack decoder: ${MHP2G_KTX2}")
